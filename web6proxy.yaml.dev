logLevel: Trace
proxy:
  # a kulso interface-re jobb tenni. nem szereti a 0.0.0.0 -s cimet - igy viszont nem hallgat a localhoston!
  hostName: 192.168.10.6
  serverPort: 3311
mail:
  server: localhost
  sender: web6proxy-alert@ledsound.hu
  operator: joelenovo@nepextel.hu

unas:
  # Lehet .hu es .eu is
  apiUrl: http://api.unas.eu/shop
  feedbackUrl: "'http://' + hostName + ':' + str(serverPort) + '/fbunas'"
  # a WewbShopban kell generalni a hozzaferesi kulcsot
  apiKey: 07968f4b0b242f409dad577eb859b780fb550b2b
    # apiKey: 838a0d5cad6241f9002a0d4596f624e89893c96b
  # A symbolbol unasba feltoltendo termekek UNAS.kategoria.Id-je. (gondolom, ezt kesobb meg egyeztetni kell)
  webcategory:
    # id: 390881
    name: Webre
  # technikai, nekem kellett, Amikor mexaladt a prg es kitiltottam magamat, akkor default ertekeket adtam vissza magamnak az UNAS hivasokkor(HA ez TRUE)
  ignoreBlockedClient: False
  cacheForceReload: 10000 # force cahce reload after this period
  #
  priceRules:
    transportModes:
      - ["Helyszíni"        ,"Személyes átvétel a bemutatótermünkben"]
      - ["MPL Futár"        ,"MPL Futárral"]
      - ["Gyűjtőzendő"      ,"Ne küldjétek még! Várjon még másik megrendelésre!"]
    paymentMethods: [
        [ "Utánvét"      , "Utánvéttel"      ],
        [ "Bankkártya"   , "Bankkártyával a helyszínen"   ],
        [ "Előre utalás" , "Előre utalással" ]
      ]

  order:
    # Unas paarmeterk: symbolId
    # Unit => seconds
    # getInterval: 1180 NOT USED most mar status szerint szed le 
    # Order params - statuses
    vouchersequencecode: B2B
    symbolOrderPrefix: H24
    symbolOrderStatusNew: 1
    status:
        new:      5422320 # Feldolgozasra var
        accepted: 5422325 # Visszaigazolva
        prepared: 5422330 # Keszletezes alatt
        shipping: 5422335 # Kiszallitas
        closed:   5422340 # Lezarva Megrendelés lezárva
        returned: 0       # NU. in UNAS (yet)
        cancel:   0       # NU. in UNAS (yet)

  customer:
    # Unas parameterek: symbolId, symbolCode
    categoryName: HU / Channel / Haffner24 UNAS
    getInterval: 600
    bulk: False
    ignoreCyclicInterval: 0  # teszteleshez Most kicsire veszem , igy Soha nem triggerelodik
    cerateMissingCustomer: True
    forceNewState: True
    handleCustomerAddress: True
    countries:
      at:  'Ausztria'
      uk:  'Egyesült Királyság'
      gr:  'Görögország'
      hu:  'Magyarország'
      de:  'Németország'
      pt:  'Portugália'
      ro:  'Románia'
      se:  'Svédország'
    codePrefix:
      default: UCO
      unregistered: UCU
      address: UCA # plus sorszam 1-99
      pattern: '%s-%i'
      patternAddr: '%s-%i-%i'

  inventory:
    warehouses: [ -1, 999999, 999998 ]

  product:
    # Unas paarmeterk: symbolId, symbolCode??, EAN, Gyarto, VTSZ
    getInterval: 600
    bulk: False
    overwriteName: False
    pricecat:
      # Symbol arkategoria ID. Ha tobb van, akkor ezeket - sorrendben - elonyben reszesiti; egyebkent a listaban az utolso ar lesz(vagy lehet, az elso)
      base: 18
      fallback1: -9999999
      fallback2: -9999999

########################################################################
mysql:
  dbFile: web6proxy
  dbHost: localhost
  dbUser: w6pusr
  dbPass: w6p-Abc+123

firebird:
  dbRoot: /opt/firebird/data/joeSyx
  dbFile: default_d.database
  dbHost: localhost
  dbUser: SYSDBA
  dbPass: Bertalan11

########################################################################
#
# Batch
batch:
  granularity: 10
  processes:
batch:
  granularity: 10
  processes:
    - orderStatus:
        startDelay: 10                     # initial delay after start BatchScheduler
        interval:   60                     # Batch thread raise/trigger interval
        name: Rendeles Statusz - UNAS      # Batch threadName
        method: orderStatusUnas            # called Entry point
        orderStatusCheckInterval: 186400    # RovModified > NOW -orderStatusCheckInterval(seconds)
        checkVoucherSequence: 42           # UNAS order type identifier
        statuses:
          - [ closed, "Megrendelés lezárva"]            # CustmerOrder.Closed = 1
          - [ manuallyClosed, "Megrendelés lezárva"]    # CustmerOrder.ClosedManually = 1
          - [ canceled, "Megrendelés lezárva"]          # CustmerOrder.Cancelled = 1
          - [ 1, "Feldolgozásra vár"]                   #   == 1, 2, 3 ...
          - [ 2, "Visszaigazolva"]                      # 
          - [ 3, "Készletezés alatt"]                   # 
    - prc1:
        startDelay: 10
        frequnecy:  200
        name: Process Egy
        method: startProcess1()
    - prc2:
        startDelay: 20
        frequnecy:  400
        name: Process Ketto
        method: startProcess2()
    - prc3:
        startDelay: 40
        frequency:  600
        name: Process Harom
        method: startProcess3()


# technikai, nekem kellett
prghelper:
  xmltag: <?xml version="1.0" encoding="UTF-8" ?>
  xmltag16: <?xml version="1.0" encoding="UTF-16" ?>
  extendedProductAttributes: True
