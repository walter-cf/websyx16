@dataclass
class Contact:
    name: Optional['Name'] = None
    phone: Optional['Phone'] = None
    mobile: Optional['Mobile'] = None
    lang: Optional['Lang'] = None

    @classmethod
    def from_element(cls, element: ET.Element) -> 'Contact':
        """Create Contact instance from XML element."""
        return cls(
            name=cls._parse_name(element),
            phone=cls._parse_phone(element),
            mobile=cls._parse_mobile(element),
            lang=cls._parse_lang(element)
        )
    
    def to_element(self) -> ET.Element:
        """Convert Contact instance to XML element."""
        element = ET.Element('Contact')
        self._serialize_name(element)
        self._serialize_phone(element)
        self._serialize_mobile(element)
        self._serialize_lang(element)
        return element
    @staticmethod
    def _parse_name(element: ET.Element) -> Optional['Name']:
        """Parse Name from XML element."""
        child = element.find('Name')
        if child is not None:
            return Name.from_element(child)
        return None
    @staticmethod
    def _parse_phone(element: ET.Element) -> Optional['Phone']:
        """Parse Phone from XML element."""
        child = element.find('Phone')
        if child is not None:
            return Phone.from_element(child)
        return None
    @staticmethod
    def _parse_mobile(element: ET.Element) -> Optional['Mobile']:
        """Parse Mobile from XML element."""
        child = element.find('Mobile')
        if child is not None:
            return Mobile.from_element(child)
        return None
    @staticmethod
    def _parse_lang(element: ET.Element) -> Optional['Lang']:
        """Parse Lang from XML element."""
        child = element.find('Lang')
        if child is not None:
            return Lang.from_element(child)
        return None
    def _serialize_name(self, parent: ET.Element) -> None:
        """Serialize name to XML element."""
        if self.name is not None:
            parent.append(self.name.to_element())
    def _serialize_phone(self, parent: ET.Element) -> None:
        """Serialize phone to XML element."""
        if self.phone is not None:
            parent.append(self.phone.to_element())
    def _serialize_mobile(self, parent: ET.Element) -> None:
        """Serialize mobile to XML element."""
        if self.mobile is not None:
            parent.append(self.mobile.to_element())
    def _serialize_lang(self, parent: ET.Element) -> None:
        """Serialize lang to XML element."""
        if self.lang is not None:
            parent.append(self.lang.to_element())


