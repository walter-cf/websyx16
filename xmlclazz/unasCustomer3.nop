        """Convert Invoice instance to XML element."""
        element = ET.Element('Invoice')
        self._serialize_name(element)
        self._serialize_z_i_p(element)
        self._serialize_city(element)
        self._serialize_street(element)
        self._serialize_street_name(element)
        self._serialize_street_number(element)
        self._serialize_county(element)
        self._serialize_country(element)
        self._serialize_country_code(element)
        self._serialize_tax_number(element)
        self._serialize_e_u_tax_number(element)
        self._serialize_tax_free(element)
