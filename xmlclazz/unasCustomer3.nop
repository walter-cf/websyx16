    z_i_p: Optional['Zip'] = None
    city: Optional['City'] = None
    street: Optional['Street'] = None
    street_name: Optional['Streetname'] = None
    street_number: Optional['Streetnumber'] = None
    county: Optional['County'] = None
    country: Optional['Country'] = None
    country_code: Optional['Countrycode'] = None
    tax_number: Optional['Taxnumber'] = None
    e_u_tax_number: Optional['Eutaxnumber'] = None
    tax_free: Optional['Taxfree'] = None

    @classmethod
    def from_element(cls, element: ET.Element) -> 'Invoice':
        """Create Invoice instance from XML element."""
        return cls(
            name=cls._parse_name(element),
            z_i_p=cls._parse_z_i_p(element),
            city=cls._parse_city(element),
            street=cls._parse_street(element),
            street_name=cls._parse_street_name(element),
            street_number=cls._parse_street_number(element),
            county=cls._parse_county(element),
            country=cls._parse_country(element),
            country_code=cls._parse_country_code(element),
            tax_number=cls._parse_tax_number(element),
            e_u_tax_number=cls._parse_e_u_tax_number(element),
            tax_free=cls._parse_tax_free(element)
        )
    
